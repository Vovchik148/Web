# Змінні середовища клієнтської частини (Vite передає в код лише змінні з префіксом VITE_).
# Скопіюйте цей файл у .env і за потреби змініть значення.

# Адреса серверної частини (лабораторні роботи 1-3)
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# Назва застосунку (відображається в шапці та підвалі)
VITE_APP_NAME=Warehouse Inventory
