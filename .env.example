# Підключення до PostgreSQL (значення збігаються з docker-compose.yml)
DATABASE_URL="postgresql://warehouse_user:warehouse_password@localhost:5432/warehouse_db?schema=public"

# Секрет для підпису JWT (у реальному проєкті - довгий випадковий рядок)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="24h"

PORT=3000
NODE_ENV=development
