DATABASE_URL="postgresql://warehouse_user:warehouse_password@localhost:5432/warehouse_db?schema=public"
JWT_SECRET=згенерований-секрет-1
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=згенерований-секрет-2
REFRESH_TOKEN_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=ID
GITHUB_CLIENT_SECRET=SECRET


# --- Рівень 3 (крок 12) ---

# Суворий ліміт запитів до /api/auth (захист від брутфорсу)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Термін дії тимчасового токена другого кроку входу з 2FA
TWO_FACTOR_TEMP_TOKEN_EXPIRES_IN=5m

# Зовнішня адреса API (для redirect_uri OAuth) та адреса фронтенду
APP_URL=http://localhost:3000

# Email (відновлення пароля). Якщо SMTP_* не задані, використовується
# тестова скринька Ethereal - прев'ю листа виводиться в консоль сервера
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password
# MAIL_FROM='"Warehouse Inventory API" <no-reply@warehouse.local>'

# OAuth GitHub: https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# --- Лабораторна робота 3: реальний час, кеш, черги, метрики ---

# Redis (кеш, черги BullMQ, Redis-адаптер Socket.io для масштабування).
# Якщо не задано - застосунок працює без нього: кеш у пам'яті процесу,
# черги виконуються одразу, Socket.io - без Redis-адаптера.
REDIS_URL=redis://localhost:6379

# Увімкнути журналювання SQL-запитів Prisma з часом виконання (для аналізу
# повільних запитів через EXPLAIN ANALYZE). 1 - увімкнено, 0 - вимкнено.
PRISMA_QUERY_LOG=0

# Метрики Prometheus на GET /metrics (1 - увімкнено)
METRICS_ENABLED=1

# Ліміти подій WebSocket: token bucket на кожен сокет
WS_RATE_LIMIT_EVENTS=30
WS_RATE_LIMIT_WINDOW_MS=1000
