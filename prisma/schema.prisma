generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  WORKER
}

enum MovementType {
  INBOUND    // надходження товару на склад
  OUTBOUND   // відвантаження зі складу
  ADJUSTMENT // коригування за результатами інвентаризації (кількість зі знаком +/-)
}

enum NotificationType {
  LOW_STOCK // залишок товару впав нижче мінімального
  MOVEMENT  // нова операція з товаром
  SYSTEM    // системні повідомлення
  PRODUCT   // зміни в каталозі товарів
}

// Пріоритети сповіщень: клієнт може сортувати/підсвічувати за ними
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(WORKER)
  isActive  Boolean  @default(true)

  // Двофакторна автентифікація (TOTP): секрет зберігаємо в БД, включається лише після підтвердження кодом
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements            StockMovement[]
  files                File[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  oauthAccounts        OAuthAccount[]
  notifications        Notification[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("suppliers")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  location  String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks    Stock[]
  movements StockMovement[]

  @@map("warehouses")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  unit        String   @default("шт")
  price       Decimal  @db.Decimal(10, 2)
  minStock    Int      @default(0)
  isActive    Boolean  @default(true)
  categoryId  Int
  supplierId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category        @relation(fields: [categoryId], references: [id])
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocks    Stock[]
  movements StockMovement[]

  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

// Проміжна таблиця зв'язку «багато-до-багатьох» Product <-> Warehouse.
// Зберігає поточний залишок конкретного товару на конкретному складі.
model Stock {
  id          Int      @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId]) // фільтр залишків за одним складом
  @@map("stocks")
}

// Журнал руху товарів (незмінний): кожна операція змінює залишок у Stock.
model StockMovement {
  id          Int          @id @default(autoincrement())
  type        MovementType
  quantity    Int
  note        String?
  productId   Int
  warehouseId Int
  userId      Int
  createdAt   DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  // Складені індекси для журналів руху: фільтр за товаром/складом + сортування за датою
  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("stock_movements")
}

model File {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  uploadedBy   Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
  @@map("files")
}

// Журнал дій користувачів (незмінний, як і stock_movements)
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     // null - дія без автентифікованого користувача (наприклад, невдалий вхід)
  action    String   // наприклад "auth.login", "product.create"
  entity    String?  // назва сутності: "user", "product", "file" тощо
  entityId  String?  // id сутності рядком - щоб логувати і нецілі числові ідентифікатори
  ip        String?
  details   Json?    // довільні деталі дії (що змінено, з яким email тощо)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Одноразові токени скидання пароля: у БД зберігаємо лише хеш
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Сховище сповіщень: створюються сервісом при важливих подіях
// (низький залишок, зміни товарів тощо) і доставляються в реальному часі через WebSocket
model Notification {
  id        Int                  @id @default(autoincrement())
  userId    Int
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  message   String
  data      Json?                // довільні деталі (id товару, дефіцит тощо)
  readAt    DateTime?            // null - сповіщення не прочитане
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt]) // «непрочитані» та лічильник unread
  @@index([userId, createdAt]) // список сповіщень користувача
  @@map("notifications")
}

// Історія подій реального часу з порядковим номером (id):
// після перепідключення клієнт надсилає останній отриманий _seq
// і отримує все, що сталося далі (events:sync)
model EventLog {
  id        Int      @id @default(autoincrement())
  type      String   // "stock.updated", "product.created" тощо
  room      String   // кімната розсилки: "warehouse:1", "products", "user:5"
  payload   Json
  createdAt DateTime @default(now())

  @@index([room, id]) // вибірка пропущених подій кімнати після останнього seq
  @@index([createdAt])
  @@map("event_logs")
}

// Прив'язка облікового запису зовнішнього провайдера (наприклад, GitHub) до користувача
model OAuthAccount {
  id                Int    @id @default(autoincrement())
  provider          String // "github", "google" тощо
  providerAccountId String // id користувача в провайдері
  userId            Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
